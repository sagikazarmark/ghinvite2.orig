# Reference names only. Inject real secrets through the selected host's secret manager.
# This is not a working deployment or an authorization to switch storage backends.
P1_HOST=p1.example.com
P1_APP_STAGE=repo
GHINVITE_LISTEN_ADDR=127.0.0.1:9080
# Same-authority production workflow fallback; web remains on Workers.
GHINVITE_STORAGE=d1-bridge
GHINVITE_D1_BRIDGE_URL=https://private-bridge.example.com/v1/d1
GHINVITE_D1_AUTHORITY_MANIFEST=/etc/ghinvite/authority.json
# GHINVITE_D1_BRIDGE_TOKEN: inject 32 random bytes encoded as 64 lowercase hex.
# Do not set GHINVITE_DATABASE_PATH in d1-bridge mode.
# Local development only: GHINVITE_STORAGE=local-sqlite and
# GHINVITE_DATABASE_PATH=/var/lib/ghinvite/ghinvite.sqlite
GHINVITE_ISLAND_ASSETS_DIR=/opt/ghinvite/public/assets
# Required workflow secret/configuration names:
# GH_REPO_APP_ID, GH_REPO_CLIENT_ID, GH_REPO_PRIVATE_KEYS, RESTATE_IDENTITY_KEYS
# Required production web names (web stays on Workers for the ADR0010 fallback):
# RESTATE_INGRESS_URL, RESTATE_INGRESS_TOKEN, P1_KEYRING,
# GH_REPO_WEBHOOK_SECRETS
# Match every capability flag to the captured serving deployment:
# GH_ORG_DELIVERY_ENABLED, GH_ACCESS_REMOVAL_ENABLED,
# GH_REISSUE_ENABLED, GH_BULK_ENABLED
# Org stage additionally requires GH_ORG_APP_ID, GH_ORG_CLIENT_ID,
# GH_ORG_PRIVATE_KEYS and, for web, GH_ORG_WEBHOOK_SECRETS.
# Web always requires the sign-in App's GH_SIGNIN_CLIENT_ID and GH_SIGNIN_CLIENT_SECRET.
# Org/email bulk requires P1_EMAIL_KEYRING on both participating hosts.
# Never use --local-unsigned or --local-dev for a production endpoint.
